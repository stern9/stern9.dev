# Copy to .env and fill in. Never commit .env.

# Spotify API (https://developer.spotify.com/dashboard)
# Spotify app client ID, used for Now Playing and Top Tracks.
SPOTIFY_CLIENT_ID=
# Spotify app client secret.
SPOTIFY_CLIENT_SECRET=
# Long-lived refresh token for your Spotify account.
SPOTIFY_REFRESH_TOKEN=

# Resend (https://resend.com/api-keys)
# API key used by the contact form.
RESEND_API_KEY=
# Address that receives contact form messages.
TO_EMAIL_ADDRESS=
# Verified sender address for contact form emails.
FROM_EMAIL_ADDRESS=

# Anthropic
# API key for Doofus and the playlist blurb; if unset, Doofus uses canned replies and the blurb is skipped.
ANTHROPIC_API_KEY=
# Max Doofus replies per day across all visitors (default 200).
DOOFUS_DAILY_LIMIT=200

# Analytics
# Google Analytics measurement ID (e.g. G-XXXXXXX); analytics are off if unset.
NEXT_PUBLIC_GA_ID=
